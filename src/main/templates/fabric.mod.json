{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "Unofficial fork of FlightAssistant with HUD displays and informational alerts only. Autopilot, auto-thrust, flight protections, auto-elytra, firework automation and flight plans have been removed, for servers that disallow flight automation.",
    "authors": [
        "Resident007 (HUD Edition Maintainer)",
        "Henner4746 (Port Maintainer)",
        "Octol1ttle (Original Author)",
        "mctaylors"
    ],
    "contact": {
        "homepage": "https://github.com/Resident007/FlightAssistant-HUD-Edition",
        "sources": "https://github.com/Resident007/FlightAssistant-HUD-Edition",
        "issues": "https://github.com/Resident007/FlightAssistant-HUD-Edition/issues"
    },
    "license": "LGPL-3.0-only",
    "icon": "assets/flightassistant_hud/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            {
                "value": "ru.octol1ttle.flightassistant.FlightAssistantFabric",
                "adapter": "kotlin"
            }
        ],
        "modmenu": [
            {
                "value": "ru.octol1ttle.flightassistant.config.FAModMenuIntegration",
                "adapter": "kotlin"
            }
        ]
    },
    "depends": {
        "fabricloader": ">=0.16.3",
        "minecraft": "${mc}",
        "java": ">=17",
        "architectury": "*",
        "fabric-language-kotlin": "*",
        "yet_another_config_lib_v3": "*"
    },
    "recommends": {
        "modmenu": "*"
    }
}
